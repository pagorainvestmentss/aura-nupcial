# Variáveis de ambiente do Aura Nupcial (Vite).
# Nunca colocar valores reais em ficheiros commitados — usar .env.local (ignorado pelo git).

# Credenciais de ADMINISTRADOR da plataforma (obrigatórias em produção).
# Em desenvolvimento local existe uma conta de cortesia (admin@auranupcial.com / admin123);
# sem estas variáveis o build de produção não tem nenhuma conta de admin.
VITE_ADMIN_EMAIL="admin@exemplo.com"
VITE_ADMIN_PASSWORD="altere-aqui"

# Vite: subcaminho quando o site é servido de um subdirectório (GitHub Pages usa /aura-nupcial/).
# VITE_BASE="/"
